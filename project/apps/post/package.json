{
  "name": "@project/post",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/post/dist/package.json",
          "{workspaceRoot}/apps/post/dist/package-lock.json"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/post/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@project/post:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@project/post:build:development"
          },
          "production": {
            "buildTarget": "@project/post:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "db-validate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx prisma validate",
          "cwd": "apps/post"
        }
      },
      "db-generate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx prisma generate",
          "cwd": "apps/post"
        }
      },
      "db-migrate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx prisma migrate dev",
          "cwd": "apps/post"
        }
      },
      "db-reset": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx prisma migrate reset --force",
          "cwd": "apps/post"
        }
      },
      "db-fill": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx prisma db seed",
          "cwd": "apps/post"
        }
      }
    }
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0"
  },
  "dependencies": {
    "dotenv": "^18.0.9"
  }
}
